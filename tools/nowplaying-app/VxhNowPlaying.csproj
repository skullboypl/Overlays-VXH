<Project Sdk="Microsoft.NET.Sdk">
  <!-- VXH Now Playing: reads Windows' "now playing" (Spotify, YouTube in the browser, Apple Music, Tidal, VLC...)
       and sends it to the streamer's OBS panel. No window framework: tray icon through the Windows API. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VXH Now Playing</AssemblyName>
    <RootNamespace>VxhNowPlaying</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>VXH Now Playing</Product>
    <Company>VXH</Company>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
